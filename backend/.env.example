# ---- MusterGo backend environment (copy this file to ".env" and edit) ----
# Your LOCAL MySQL connection. Each developer runs their own MySQL server.

# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=YOUR_MYSQL_PASSWORD
# DB_NAME=mustergo

# Port the API listens on (optional; defaults to 4000)
# PORT=4000

# Your deployed frontend URL, for CORS in production (optional locally)
# FRONTEND_URL=https://your-app.vercel.app
