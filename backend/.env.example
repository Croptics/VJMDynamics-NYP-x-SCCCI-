# ---- MusterGo backend environment ----
# 1. Copy to ".env" and fill in 
#    Only DATABASE_URL is required to run the app.
# 2. everything else is optional 
#    (each feature it powers just shows a clear "not configured" message if skipped).

# Required — Postgres connection string (e.g. from Neon).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Recommended — signs login sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cloudinary(Optional) — delegate profile photo uploads.
# dashboard (cloudinary.com, free tier).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel(Optional) — only needed once deployed (CORS).
FRONTEND_URL=https://your-app.vercel.app

# AI Insights(Optional) — powers "Generate Insights" on the Analytics tab.
# 1. Uses local Ollama by default (free, no key: install + `ollama pull llama3.2`).
# 2. No Ollama running? Set ANTHROPIC_API_KEY instead (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Ollama model overrides (Optional — Vance's chatbot + document parsing, and
# JQ's AI features, all default sensibly without these).
# OLLAMA_MODEL=llama3.2:1b        # chatbot model (1b = fast demo; omit for llama3.2 3B, more accurate)
# OLLAMA_PARSE_MODEL=llama3.2     # document-parsing model (defaults to llama3.2 / 3B)

# Escalations — "Escalate to office" email (Optional, free).
# Any SMTP provider works (Gmail app password, SendGrid SMTP relay, AWS SES...).
# Without this, escalations still work in-app (banner/tab-flash/chime) — only
# the email step is skipped.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional override — comma-separated email addresses. Without this,
# escalation emails go to every APPROVED admin account's own email instead.
ESCALATION_EMAIL_TO=

# FaceCheck enrolment invites (Optional). Reuses the same SMTP_* block above.
#
# PUBLIC_APP_URL is the base URL written into the "Start enrolment" link inside
# every invite. GET THIS WRONG AND THE EMAIL STILL SENDS — it just arrives with
# a link the delegate can't open, which is the hardest version of this to spot.
# It must be a URL reachable from a delegate's own phone on mobile data:
#   good: https://mustergo.vercel.app        (deployed)
#   good: https://abc123.ngrok-free.app      (tunnel, for a live demo)
#   bad:  http://localhost:5173              (only this machine)
#   bad:  https://192.168.0.13:5173          (your wifi only, self-signed cert,
#                                             and the IP changes)
# The server warns at boot, and the invite preview flags it, if this looks
# unreachable. Defaults to http://localhost:5173.
PUBLIC_APP_URL=
# Force preview mode even with SMTP fully configured: renders and logs every
# invite without transmitting anything. Any value other than "true" sends for
# real. Unset SMTP_* above and this is implied.
MAIL_DRY_RUN=

# Escalations — SMS / WhatsApp (Optional, PAID — Twilio account required).
# Not wired to a real provider yet — see backend/lib/notify.js for the
# ready-to-uncomment Twilio integration. Until TWILIO_* is set below, the
# server just logs what WOULD have been sent, at no cost.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=
# Comma-separated phone numbers in E.164 format, e.g. +6591234567,+6598765432
ESCALATION_SMS_TO=
ESCALATION_WHATSAPP_TO=
