# ---- MusterGo backend environment (copy this file to ".env" and edit) ----
# Step 1: Database connection string (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Step 1b: Session token signing secret. REQUIRED before deploying anywhere
# public — without it, a hardcoded (insecure) fallback is used and a console
# warning is printed on startup. Any long random string works, e.g. generate
# one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET=


# Step 2 (deployment guide): File storage — only if a feature uploads
# files (e.g. Documents). Sign up at cloudinary.com; the dashboard shows these
# 3 values. Not needed if nothing in the app uploads files.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Step 3: Frontend URL (for CORS)
# FRONTEND_URL=https://your-app.vercel.app

# Step 4: AI Analytics Insights — powers the "Generate Insights" button on
# the Dashboard's Analytics tab. Two options, tried in this order:
#
#   a) Local Ollama (free, no key, nothing leaves your machine). Install
#      from ollama.com, run `ollama pull llama3.2`, then leave the API key
#      below unset — these two lines only need setting if Ollama runs
#      somewhere other than the default localhost:11434 or you pulled a
#      different model name.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2
#
#   b) Anthropic API (used automatically if Ollama isn't running). Get a
#      key at console.anthropic.com.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
#
# If neither is set up, the button shows a clear "not configured" message.

