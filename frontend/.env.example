# ---- MusterGo frontend environment ----
# 1. Copy to ".env" and fill in.
#    Nothing here is required to run the app locally.

# Google Maps(Optional) — powers the small map on a delegate's
# "Last known location". Get a free key at console.cloud.google.com,
# enable "Maps Embed API" for it (no billing needed for its free tier).
VITE_GOOGLE_MAPS_API_KEY=

# AMap / 高德地图 (Optional) — the OTHER tab on "Last known location".
# Google Maps is BLOCKED in mainland China, so on a China trip this is the tab
# that actually works. The tab already functions with NO key (it previews
# AMap's public page and always offers an "Open in AMap" link) — a key only
# upgrades it to a clean embedded map pinned to the exact address.
# Getting one needs a mainland-China mobile number + real-name verification at
# console.amap.com ("Web服务" / Web service key). If the client or their China
# partner has an account, paste the key here; otherwise leave it blank and the
# link-out keeps working. See README/THIRD_PARTY_SERVICES.md.
VITE_AMAP_KEY=

# Deployment(Optional) — only needed once deployed. Local dev doesn't need
# this; the Vite dev server proxy already routes /api to localhost:4000.
VITE_API_URL=https://your-app.onrender.com
